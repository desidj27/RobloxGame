--!nonstrict
-- Fishing minigame (server authority).
--   1. Client sends FishCast at a spot. Server waits biteWait(FishingSpeed).
--   2. Server fires FishingBite with the reaction window.
--   3. Client must send FishReel inside the window. On success the server
--      rolls a fish the player's Fishing Power can hook, with Fishing Luck
--      skewing the roll towards rarer fish, and pays the world's currency.

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Fish = require(Shared.Config.Fish)
local GameConfig = require(Shared.Config.GameConfig)
local Rarities = require(Shared.Config.Rarities)
local Network = require(Shared.Network)
local Formulas = require(Shared.Util.Formulas)
local Weighted = require(Shared.Util.Weighted)

local CurrencyService = require(script.Parent.CurrencyService)
local DataService = require(script.Parent.DataService)
local PetService = require(script.Parent.PetService)

local FishingService = {}

FishingService.SPOT_TAG = "FishingSpot"

type Spot = {
	part: BasePart,
	worldId: string,
	weights: { [string]: number },
}

type Session = {
	spotId: string,
	state: "waiting" | "bite",
	biteAt: number,
	token: number,
}

local spots: { [string]: Spot } = {}
local sessions: { [Player]: Session } = {}
local rng = Random.new()
local tokenCounter = 0

local function notify(player: Player, message: string, kind: string?)
	Network.event("Notify"):FireClient(player, message, kind or "info")
end

-- Adopts an existing BasePart (hand-placed water or generated by WorldService)
-- as a fishing spot. `spotId` must be unique across all worlds.
function FishingService.RegisterSpot(worldId: string, spotId: string, part: BasePart, weights: { [string]: number })
	if spots[spotId] then
		warn(`[FishingService] duplicate fishing spot id "{spotId}", skipping {part:GetFullName()}`)
		return
	end
	part.Anchored = true
	part:SetAttribute("WorldId", worldId)
	part:SetAttribute("SpotId", spotId)

	local prompt = part:FindFirstChildOfClass("ProximityPrompt") or Instance.new("ProximityPrompt")
	prompt.ActionText = "Cast line"
	prompt.ObjectText = "Fishing spot"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = GameConfig.FISH_INTERACT_RANGE
	prompt.RequiresLineOfSight = false
	prompt.Parent = part

	CollectionService:AddTag(part, FishingService.SPOT_TAG)

	spots[spotId] = { part = part, worldId = worldId, weights = weights }
end

local function inRange(player: Player, part: BasePart): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	-- Distance to the water's bounding box edge rather than its centre.
	local localPos = part.CFrame:PointToObjectSpace(root.Position)
	local half = part.Size / 2
	local dx = math.max(0, math.abs(localPos.X) - half.X)
	local dz = math.max(0, math.abs(localPos.Z) - half.Z)
	return math.sqrt(dx * dx + dz * dz) <= GameConfig.FISH_INTERACT_RANGE
end

local function endSession(player: Player)
	sessions[player] = nil
end

local function rollFish(spot: Spot, stats): string?
	local weights = {}
	for fishId, weight in spot.weights do
		local def = Fish[fishId]
		if def and stats.FishingPower >= def.requiredPower then
			weights[fishId] = Formulas.luckWeight(weight, Rarities[def.rarity].order, stats.FishingLuck)
		end
	end
	return Weighted.pick(weights, rng:NextNumber())
end

local function onCast(player: Player, spotId: any)
	if type(spotId) ~= "string" then
		return
	end
	local spot = spots[spotId]
	if not spot or sessions[player] then
		return
	end
	local profile = DataService.Get(player)
	if not profile or not inRange(player, spot.part) then
		return
	end

	tokenCounter += 1
	local session: Session = { spotId = spotId, state = "waiting", biteAt = 0, token = tokenCounter }
	sessions[player] = session

	local stats = PetService.GetStats(player)
	local wait = Formulas.biteWait(stats.FishingSpeed, rng:NextNumber())

	task.delay(wait, function()
		if sessions[player] ~= session then
			return
		end
		if not inRange(player, spot.part) then
			endSession(player)
			Network.event("FishingResult"):FireClient(player, spotId, nil, 0)
			return
		end
		session.state = "bite"
		session.biteAt = os.clock()
		Network.event("FishingBite"):FireClient(player, spotId, GameConfig.FISH_BITE_WINDOW)

		task.delay(GameConfig.FISH_BITE_WINDOW + 0.25, function()
			if sessions[player] == session then
				endSession(player)
				Network.event("FishingResult"):FireClient(player, spotId, nil, 0)
			end
		end)
	end)
end

local function onReel(player: Player, spotId: any)
	local session = sessions[player]
	if not session or session.spotId ~= spotId then
		return
	end
	local spot = spots[session.spotId]
	local profile = DataService.Get(player)
	if not spot or not profile then
		endSession(player)
		return
	end

	if session.state == "waiting" then
		-- Reeling before the bite cancels the cast.
		endSession(player)
		Network.event("FishingResult"):FireClient(player, spotId, nil, 0)
		return
	end

	-- Small grace for network latency.
	if os.clock() - session.biteAt > GameConfig.FISH_BITE_WINDOW + 0.2 then
		endSession(player)
		Network.event("FishingResult"):FireClient(player, spotId, nil, 0)
		return
	end

	endSession(player)
	local stats = PetService.GetStats(player)
	local fishId = rollFish(spot, stats)
	if not fishId then
		notify(player, "Nothing here bites at your Fishing Power yet", "error")
		Network.event("FishingResult"):FireClient(player, spotId, nil, 0)
		return
	end

	local def = Fish[fishId]
	local coins = Formulas.fishPayout(def.coins, profile.rebirths)
	CurrencyService.Add(player, spot.worldId, coins)
	profile.stats.FishCaught += 1
	profile.lifetime.FishCaught += 1
	if Rarities[def.rarity].order >= Rarities.Rare.order then
		profile.stats.RareFinds += 1
	end
	DataService.MarkDirty(player)

	Network.event("FishingResult"):FireClient(player, spotId, fishId, coins)
end

function FishingService.Init()
	Network.event("FishCast").OnServerEvent:Connect(onCast)
	Network.event("FishReel").OnServerEvent:Connect(onReel)
	Players.PlayerRemoving:Connect(endSession)
end

return FishingService

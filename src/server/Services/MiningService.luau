--!nonstrict
-- Mining minigame (server authority). Clients send one MineHit per swing; the
-- server validates cooldown and range, applies damage = Mining Power (with a
-- luck-based crit chance), pays out the world's currency when the node breaks
-- and respawns the node with a freshly rolled ore type.
--
-- Node state is mirrored onto the Part as attributes so the client can draw
-- health bars without extra remotes:
--   OreId: string, Health: number, MaxHealth: number, Depleted: boolean

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local Ores = require(Shared.Config.Ores)
local Rarities = require(Shared.Config.Rarities)
local Network = require(Shared.Network)
local Formulas = require(Shared.Util.Formulas)
local Weighted = require(Shared.Util.Weighted)

local CurrencyService = require(script.Parent.CurrencyService)
local DataService = require(script.Parent.DataService)
local PetService = require(script.Parent.PetService)

local MiningService = {}

MiningService.NODE_TAG = "OreNode"

-- Veins are tinted toward white so they read against the rock they sit on.
local VEIN_TINT = 0.35

type Node = {
	part: BasePart,
	prompt: ProximityPrompt,
	worldId: string,
	weights: { [string]: number },
	oreId: string,
	health: number,
	maxHealth: number,
	depleted: boolean,
}

local nodes: { [string]: Node } = {}
local lastSwing: { [Player]: number } = {}
local rng = Random.new()
local nodeCounter = 0

-- Decorative child parts of a node (hand-placed "veins" in the starter world)
-- follow the rolled ore's colour and fade out with the rock when it is depleted.
local function styleVeins(part: BasePart, color: Color3?, material: Enum.Material?, transparency: number)
	for _, child in part:GetChildren() do
		if child:IsA("BasePart") then
			if color then
				child.Color = color
			end
			if material then
				child.Material = material
			end
			child.Transparency = transparency
		end
	end
end

local function applyOre(node: Node, oreId: string)
	local ore = Ores[oreId]
	node.oreId = oreId
	node.health = ore.health
	node.maxHealth = ore.health
	node.depleted = false

	local part = node.part
	part.Color = ore.color
	part.Material = ore.material
	part.Size = Vector3.new(ore.size, ore.size, ore.size)
	part.Transparency = 0
	part.CanCollide = true
	styleVeins(part, ore.color:Lerp(Color3.new(1, 1, 1), VEIN_TINT), ore.material, 0)
	part:SetAttribute("OreId", oreId)
	part:SetAttribute("Health", node.health)
	part:SetAttribute("MaxHealth", node.maxHealth)
	part:SetAttribute("Depleted", false)
	node.prompt.Enabled = true
	node.prompt.ObjectText = ore.name
end

local function rollOre(node: Node): string
	return Weighted.pick(node.weights, rng:NextNumber()) or next(node.weights)
end

local function deplete(node: Node)
	local ore = Ores[node.oreId]
	node.depleted = true
	node.health = 0
	node.part:SetAttribute("Health", 0)
	node.part:SetAttribute("Depleted", true)
	node.part.Transparency = 0.85
	node.part.CanCollide = false
	styleVeins(node.part, nil, nil, 0.85)
	node.prompt.Enabled = false

	task.delay(ore.respawnTime, function()
		if nodes[node.part.Name] == node then
			applyOre(node, rollOre(node))
		end
	end)
end

-- Adopts an existing BasePart (hand-placed in Studio or generated by
-- WorldService) as an ore node. The part is renamed to a unique id, tagged,
-- given a ProximityPrompt and driven entirely by the server from then on.
function MiningService.RegisterNode(worldId: string, part: BasePart, weights: { [string]: number })
	nodeCounter += 1
	local name = `Ore_{worldId}_{nodeCounter}`
	part.Name = name
	part.Anchored = true
	part:SetAttribute("WorldId", worldId)

	local prompt = part:FindFirstChildOfClass("ProximityPrompt") or Instance.new("ProximityPrompt")
	prompt.ActionText = "Mine"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = GameConfig.MINE_INTERACT_RANGE - 2
	prompt.RequiresLineOfSight = false
	prompt.Parent = part

	CollectionService:AddTag(part, MiningService.NODE_TAG)

	local node: Node = {
		part = part,
		prompt = prompt,
		worldId = worldId,
		weights = weights,
		oreId = "",
		health = 0,
		maxHealth = 0,
		depleted = false,
	}
	nodes[name] = node
	applyOre(node, rollOre(node))
	return part
end

local function inRange(player: Player, part: BasePart): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	return (root.Position - part.Position).Magnitude <= GameConfig.MINE_INTERACT_RANGE + part.Size.X
end

local function onMineHit(player: Player, nodeName: any)
	if type(nodeName) ~= "string" then
		return
	end
	local node = nodes[nodeName]
	if not node or node.depleted then
		return
	end
	local profile = DataService.Get(player)
	if not profile then
		return
	end

	local now = os.clock()
	if now - (lastSwing[player] or 0) < GameConfig.MINE_SWING_COOLDOWN * 0.9 then
		return
	end
	lastSwing[player] = now

	if not inRange(player, node.part) then
		return
	end

	local stats = PetService.GetStats(player)
	local crit = rng:NextNumber() < Formulas.critChance(stats.MiningLuck)
	local damage = stats.MiningPower * (if crit then GameConfig.MINE_CRIT_MULTIPLIER else 1)
	node.health = math.max(0, node.health - damage)
	node.part:SetAttribute("Health", node.health)

	Network.event("MiningHit"):FireClient(player, nodeName, damage, crit, node.health)

	if node.health <= 0 then
		local ore = Ores[node.oreId]
		local richVein = rng:NextNumber() < Formulas.richVeinChance(stats.MiningLuck)
		local coins = Formulas.orePayout(ore.coins, profile.rebirths, richVein)

		CurrencyService.Add(player, node.worldId, coins)
		profile.stats.OresMined += 1
		profile.lifetime.OresMined += 1
		if Rarities[ore.rarity].order >= Rarities.Rare.order then
			profile.stats.RareFinds += 1
		end
		DataService.MarkDirty(player)

		Network.event("MiningBroke"):FireClient(player, nodeName, node.oreId, coins, richVein)
		deplete(node)
	end
end

function MiningService.Init()
	Network.event("MineHit").OnServerEvent:Connect(onMineHit)
	Players.PlayerRemoving:Connect(function(player)
		lastSwing[player] = nil
	end)
end

return MiningService
